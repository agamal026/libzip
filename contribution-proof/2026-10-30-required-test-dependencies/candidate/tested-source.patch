@@ -369,11 +373,24 @@ endif()
 find_program(NIHTEST nihtest)
 
 if(BUILD_REGRESS AND NOT NIHTEST)
+  if(REQUIRE_TEST_DEPENDENCIES)
+    message(FATAL_ERROR "Regression tests require nihtest; install it or disable BUILD_REGRESS")
